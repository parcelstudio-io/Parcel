# Parcel — the companion runtime. SKELETON: never run as a service.
#
#   Card     A4 SPINE (scrum/20260824/task_2), finding EMBODIMENT-KERNEL K6
#   Design   research/20260824/PORTABLE_LIVING_DOG_HLD.md §3, §6
#
# TODO before this unit can start anything:
#   * /opt/parcel/bin/parcel-runtime does not exist. `parcel_robot.runtime`
#     runs today as a desktop process against a simulator backend; packaging it
#     for pinned aarch64 is Gate 2's other half and has not been done.
#   * the runtime must hold NO vendor SDK or device handle (HLD §3). Today it
#     holds a `SimulatorBackend`; on the robot it must hold a
#     MotionGatewayClient and nothing else.
#   * the hosted connector's spend governor (card A7) is not built. Until it
#     is, this unit must not be given network credentials.
#
# The owner's live desktop stack (:8765, /tmp/parcel_sim.sock, :8080) is a
# DIFFERENT thing from this unit and is never touched by it.

[Unit]
Description=Parcel companion runtime (world model, conversation, drives, memory)
Documentation=file:///opt/parcel/doc/PORTABLE_LIVING_DOG_HLD.md
After=parcel-gateway.service parcel-safety.service parcel-lio.service parcel-audio.service
Wants=parcel-lio.service parcel-audio.service
# Requires= makes both authority services start first. BindsTo= plus After=
# also stops runtime when either service fails or becomes inactive unexpectedly;
# Requires= alone covers only activation and explicit stop/restart propagation.
# Losing LIO or audio remains a degraded companion rather than motion authority.
Requires=parcel-gateway.service parcel-safety.service
BindsTo=parcel-gateway.service parcel-safety.service

[Service]
Type=notify
NotifyAccess=main
User=parcel-runtime
Group=parcel-runtime
SupplementaryGroups=parcel-motion
# Optional hosted credentials and runtime tuning live here. EnvironmentFile=
# overrides Environment= regardless of directive order, so fixed invariants are
# deliberately assigned later by /usr/bin/env in ExecStart, not Environment=.
EnvironmentFile=-/etc/parcel/runtime.env
ExecStartPre=/usr/bin/test -x /opt/parcel/bin/parcel-runtime
# Keep one authoritative profile selector. The reviewed, loadable physical-rig
# overlay is configs/robot.go2_edu_plus.yaml; a `physical` profile does not
# exist. Command-line selection takes precedence over PARCEL_PROFILE, including
# an accidental value inherited through runtime.env.
# The socket is fixed after runtime.env, is never world-writable, and kernel UID
# still decides lease authority through the parcel-motion group.
ExecStart=/usr/bin/env PARCEL_ARMED=0 PARCEL_ROLE=runtime PARCEL_GATEWAY_SOCKET=/run/parcel-gateway/gateway.sock /opt/parcel/bin/parcel-runtime --disarmed --profile go2_edu_plus
Restart=on-failure
RestartSec=5
WatchdogSec=10
StateDirectory=parcel/runtime
LogsDirectory=parcel/runtime
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=6G
