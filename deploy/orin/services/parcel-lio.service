# Parcel — LiDAR-inertial odometry and map health. SKELETON: never run.
#
#   Card     A4 SPINE (scrum/20260824/task_2), finding EMBODIMENT-KERNEL K6
#   Design   research/20260824/PORTABLE_LIVING_DOG_HLD.md §3, §8.3, Gate 5
#
# TODO before this unit can start anything:
#   * /opt/parcel/bin/parcel-lio does not exist. What DOES exist, in-process:
#     parcel_robot/localization/{gicp_provider,discontinuity,global_match,
#     jump_journal}.py — A3's latch, runner-up margin and jump journal, which
#     card A4 installed behind the runtime's pose seam. The estimator itself is
#     a scan-match stub; a real LIO is Gate 5.
#   * the Mid-360 driver, its extrinsics and the IMU time map are box-day work.
#   * WholeMapMatcher needs a RangeTemplateSource. The product has no map source
#     that can answer free()/template(), so the matcher is built only when one
#     is supplied (parcel_robot/localization/installer.py). Recorded, not stubbed.
#
# This process MUST NOT make mission-success claims (HLD §3). It publishes
# pose, covariance, innovation, jump and relocalization evidence; whether the
# robot arrived is somebody else's sentence.

[Unit]
Description=Parcel LIO (MAP->ODOM, localization health and jump evidence)
Documentation=file:///opt/parcel/doc/PORTABLE_LIVING_DOG_HLD.md
After=parcel-safety.service

[Service]
Type=notify
NotifyAccess=main
User=parcel-lio
Group=parcel-lio
# Optional commissioned calibration/provider settings may live here. Fixed
# disarm and role are assigned after the file by ExecStart's /usr/bin/env.
EnvironmentFile=-/etc/parcel/lio.env
ExecStartPre=/usr/bin/test -x /opt/parcel/bin/parcel-lio
# A restart is a NEW process epoch. Every consumer must see the epoch change
# and refuse to join pre-restart geometry to post-restart pose
# (parcel_robot/contracts/evidence_header.py::mixed_epoch_sources).
ExecStart=/usr/bin/env PARCEL_ARMED=0 PARCEL_ROLE=lio /opt/parcel/bin/parcel-lio --disarmed --publish-epoch
Restart=on-failure
RestartSec=2
WatchdogSec=5
StateDirectory=parcel/lio
LogsDirectory=parcel/lio
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=2G
