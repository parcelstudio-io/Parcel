# Parcel — the independent safety supervisor. SKELETON: never run.
#
#   Card     A4 SPINE (scrum/20260824/task_2), finding EMBODIMENT-KERNEL K6
#   Design   research/20260824/PORTABLE_LIVING_DOG_HLD.md §3, §5 (authority)
#
# SCOPE DEVIATION, stated: HLD §3 splits `parcel-safety` from
# `parcel-sensor-hub`. This card ships five units, so the sensor-hub duties are
# listed here as TODOs rather than given a sixth file. Splitting them is Gate 3
# work and lands with the manifest they own.
#
# TODO before this unit can start anything:
#   * /opt/parcel/bin/parcel-safety does not exist. Card A6 STOP-LOCAL owns the
#     always-local spoken STOP; the observation-health gate exists in-process
#     today (parcel_robot/core/input_health.py) and has never run standalone.
#   * SENSOR HUB (deferred): monotonic clock mapping, frames/extrinsics and the
#     calibration manifest have no owner process. Until they do, the physical
#     observation source refuses to produce a snapshot
#     (parcel_robot/observation/sources.py::PhysicalObservationSource).
#   * the E-stop and remote inputs are GPIO/serial reads that no code performs.
#
# This process must never block on disk, network or model work: HLD §3 forbids
# it because a supervisor that can be starved is not a supervisor. IOSchedule
# and Nice below are the systemd half of that promise; the code half is unbuilt.

[Unit]
Description=Parcel safety supervisor (independent STOP, observation-health gate)
Documentation=file:///opt/parcel/doc/PORTABLE_LIVING_DOG_HLD.md
After=parcel-gateway.service
Wants=parcel-gateway.service
# Deliberately NOT Requires=: the supervisor's whole purpose is to hold STOP
# authority when the gateway is unavailable. It must survive its absence.

[Service]
Type=notify
NotifyAccess=main
User=parcel-safety
Group=parcel-safety
Environment=PARCEL_ARMED=0
Environment=PARCEL_ROLE=safety
EnvironmentFile=-/etc/parcel/safety.env
ExecStartPre=/usr/bin/test -x /opt/parcel/bin/parcel-safety
ExecStart=/opt/parcel/bin/parcel-safety --disarmed
Restart=on-failure
RestartSec=1
WatchdogSec=1
Nice=-5
IOSchedulingClass=realtime
StateDirectory=parcel/safety
LogsDirectory=parcel/safety
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=256M
