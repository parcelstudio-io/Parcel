# Parcel — the independent stop-only software safety supervisor.
#
#   Card     A4 SPINE (scrum/20260824/task_2), finding EMBODIMENT-KERNEL K6
#   Design   research/20260824/PORTABLE_LIVING_DOG_HLD.md §3, §5 (authority)
#
# SCOPE DEVIATION, stated: HLD §3 splits `parcel-safety` from
# `parcel-sensor-hub`. This card ships five units, so the sensor-hub duties are
# listed here as TODOs rather than given a sixth file. Splitting them is Gate 3
# work and lands with the manifest they own.
#
# The `parcel-safety` console entry point now exists and has a stop-only gateway
# client. It has no acquire/command/vendor API. It is still unrun on the target.
# TODO before physical use:
#   * Card A6 STOP-LOCAL must connect the always-local spoken STOP input to this
#     principal's SIGUSR1/adapter boundary.
#   * SENSOR HUB (deferred): monotonic clock mapping, frames/extrinsics and the
#     calibration manifest have no owner process. Until they do, the physical
#     observation source refuses to produce a snapshot
#     (parcel_robot/observation/sources.py::PhysicalObservationSource).
#   * the E-stop and remote inputs are GPIO/serial reads that no code performs;
#     a physical E-stop must remain independent of this Python/Orin path.
#
# This process must never block on disk, network or model work: HLD §3 forbids
# it because a supervisor that can be starved is not a supervisor. The process
# performs only bounded Unix-socket probes/STOP and sd_notify datagrams.

[Unit]
Description=Parcel safety supervisor (independent STOP, observation-health gate)
Documentation=file:///opt/parcel/doc/PORTABLE_LIVING_DOG_HLD.md
After=parcel-gateway.service
Wants=parcel-gateway.service
# Deliberately NOT Requires=: the supervisor must keep failing visibly and
# retrying when the gateway is absent instead of being stopped with it. It
# cannot reach Unitree without the sole-writer gateway; that residual failure
# is why the robot remote/physical E-stop remains mandatory.

[Service]
Type=notify
NotifyAccess=main
User=parcel-safety
Group=parcel-safety
SupplementaryGroups=parcel-motion
# Optional commissioned watchdog/timing settings may live here. Fixed disarm,
# role, and socket values are assigned after the file by ExecStart's
# /usr/bin/env, because EnvironmentFile= always overrides Environment=.
EnvironmentFile=-/etc/parcel/safety.env
ExecStartPre=/usr/bin/test -x /opt/parcel/bin/parcel-safety
ExecStart=/usr/bin/env PARCEL_ARMED=0 PARCEL_ROLE=safety PARCEL_GATEWAY_SOCKET=/run/parcel-gateway/gateway.sock /opt/parcel/bin/parcel-safety --disarmed
Restart=on-failure
RestartSec=1
WatchdogSec=1
Nice=-5
IOSchedulingClass=realtime
StateDirectory=parcel/safety
LogsDirectory=parcel/safety
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryMax=256M
