{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParcelOfflineExternalNavReport",
  "type": "object",
  "required": ["generated_at", "aggregate", "by_task", "compatibility", "notes"],
  "properties": {
    "generated_at": { "type": "string" },
    "seed": { "type": "integer" },
    "episodes_per_task": { "type": "integer" },
    "agent": { "type": "string" },
    "aggregate": { "type": "object" },
    "by_task": { "type": "object" },
    "compatibility": { "type": "array" },
    "episodes": { "type": "array" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
