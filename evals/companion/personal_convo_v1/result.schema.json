{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PERSONAL_CONVO_V1 text-tier (Tier T) result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "suite_id",
    "runner_version",
    "tier",
    "run_id",
    "recorded_at_utc",
    "provider",
    "manifest_sha256",
    "pack_digest",
    "locked_files",
    "provenance",
    "scenario_count",
    "families",
    "family_status",
    "case_verdicts",
    "aggregate",
    "scenarios",
    "claims",
    "does_not_prove"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "suite_id": { "const": "parcel-personal-convo-v1" },
    "runner_version": { "type": "string" },
    "tier": {
      "const": "T",
      "description": "Text-transcript tier, per-commit CI. Tier A (audio e2e) is a separate owner-gated card."
    },
    "run_id": { "type": "string", "minLength": 1 },
    "recorded_at_utc": { "type": "string", "minLength": 1 },
    "provider": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["fixture", "live"] }
      }
    },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pack_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Digest over the sorted locked-file hashes; stable across runs of the frozen pack."
    },
    "locked_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Model / backend / reference provenance block (single-delta swap protocol input)."
    },
    "scenario_count": { "type": "integer", "minimum": 1 },
    "families": { "type": "array", "items": { "type": "string" } },
    "family_status": {
      "type": "object",
      "description": "family -> pass | recency_window_blocked | fail. The honest headline lives here.",
      "additionalProperties": { "enum": ["pass", "recency_window_blocked", "fail"] }
    },
    "case_verdicts": {
      "type": "object",
      "description": "turn_id -> pass|fail. The determinism contract: two runs on the frozen pack under the fixture provider must produce an identical object.",
      "additionalProperties": { "enum": ["pass", "fail"] }
    },
    "aggregate": { "type": "object" },
    "scenarios": { "type": "array", "items": { "type": "object" } },
    "claims": { "type": "object" },
    "does_not_prove": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Mandatory. A Tier-T report that omits its limits (recency window, no human coverage, no judge) is a misleading report."
    }
  }
}
