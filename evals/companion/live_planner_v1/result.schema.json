{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parcel.local/evals/companion/live_planner_v1/result.schema.json",
  "title": "Parcel live planner v1 result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "runner_version",
    "run_id",
    "recorded_at_utc",
    "change_description",
    "capture_method",
    "corpus",
    "inference",
    "provider_metrics",
    "output",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "suite_id": {"const": "parcel-live-planner-v1"},
    "runner_version": {"const": "live-planir-boundary-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "change_description": {"type": "string", "minLength": 1, "maxLength": 500},
    "capture_method": {"type": "string", "minLength": 1, "maxLength": 80},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_sha256",
        "planner_prompt_sha256",
        "plan_schema_sha256",
        "turn_id",
        "snapshot_id",
        "transcript"
      ],
      "properties": {
        "case_id": {"const": "live-sidewalk-plan-v1"},
        "case_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "planner_prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plan_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "turn_id": {"const": "live-sidewalk-v5"},
        "snapshot_id": {"const": "live-sidewalk-snapshot-v5"},
        "transcript": {"type": "string", "minLength": 1}
      }
    },
    "inference": {"type": "object"},
    "provider_metrics": {
      "type": "object",
      "required": ["overall_elapsed_ms"],
      "properties": {
        "overall_elapsed_ms": {"type": "number", "minimum": 0},
        "model_http_ms": {"type": "number", "minimum": 0},
        "model_ttft_ms": {"type": ["number", "null"], "minimum": 0},
        "model_json_validation_ms": {"type": ["number", "null"], "minimum": 0},
        "model_streaming": {"type": "boolean"},
        "model_mode": {"type": "string"},
        "reasoning_first_output_estimated": {"type": "boolean"},
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parse_status", "provider_error", "raw_plan", "validation"],
      "properties": {
        "parse_status": {"enum": ["parsed", "provider_error"]},
        "provider_error": {"type": ["object", "null"]},
        "raw_plan": {"type": ["object", "null"]},
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "code",
            "message",
            "plan_sha256",
            "effective_invariants",
            "validated_against_snapshot_id"
          ],
          "properties": {
            "status": {"enum": ["accepted", "rejected", "not_run"]},
            "code": {"type": ["string", "null"]},
            "message": {"type": ["string", "null"]},
            "plan_sha256": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{64}$"
            },
            "effective_invariants": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "validated_against_snapshot_id": {"type": ["string", "null"]}
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_scope",
        "physical_navigation_episode_count",
        "physical_navigation_success_rate",
        "does_not_prove"
      ],
      "properties": {
        "evaluation_scope": {"const": "standalone semantic PlanIR generation and validation only"},
        "physical_navigation_episode_count": {"const": 0},
        "physical_navigation_success_rate": {"type": "null"},
        "does_not_prove": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
