{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parcel frozen conversation-quality v1 result",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "suite_id", "run_id", "recorded_at_utc", "inference", "aggregate", "cases", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "suite_id": {"const": "parcel-conversation-quality-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "recorded_at_utc": {"type": "string", "minLength": 1},
    "inference": {"type": "object"},
    "aggregate": {"type": "object"},
    "cases": {"type": "array", "minItems": 1},
    "claims": {"type": "object"}
  }
}
