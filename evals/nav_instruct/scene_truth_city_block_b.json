    "null_control": {
      "alpha": 0.05,
      "min_draws": 200,
      "procedure": "re-scatter the same population uniformly over the mapped area, recompute the same statistic, report p = P(null at least as good as observed)",
      "required": true,
      "rule": "EVERY localization claim carries a null control. A number without one is not a result; the scorer cannot construct a claim without it.",
      "verdicts": {
        "fail": "the statistic did not pass",
        "pass": "the statistic passed AND beat the null at alpha",
        "uninformative": "the statistic passed but did NOT beat the null \u2014 the metric could not discriminate here, so this may not be reported as a pass"
