      pos="2.2 4.165 0.06" contype="0" conaffinity="0" density="0"/>
    <geom name="vis_shopfront_4" type="mesh" mesh="shopfront_4" material="shopfront_d"
      pos="5.5 3.865 0.06" contype="0" conaffinity="0" density="0"/>
    <geom name="vis_shopfront_5" type="mesh" mesh="shopfront_5" material="shopfront_b"
      pos="-5.5 -3.065 0.06" euler="0 0 3.14159265" contype="0" conaffinity="0" density="0"/>
    <geom name="vis_shopfront_6" type="mesh" mesh="shopfront_6" material="shopfront_d"
      pos="5.0 -3.365 0.06" euler="0 0 3.14159265" contype="0" conaffinity="0" density="0"/>


    <!-- Awnings, on the four faces with no street tree in front of them. -->
    <geom name="vis_awning_2" type="box" pos="-1.0 4.28 2.14" size="1.15 0.28 0.05"
      rgba="0.62 0.20 0.16 1" contype="0" conaffinity="0" density="0"/>
    <geom name="vis_awning_3" type="box" pos="2.2 3.90 1.90" size="1.25 0.28 0.05"
      rgba="0.16 0.24 0.46 1" contype="0" conaffinity="0" density="0"/>
    <geom name="vis_awning_5" type="box" pos="-5.5 -2.82 1.98" size="1.40 0.28 0.05"
      rgba="0.20 0.36 0.28 1" contype="0" conaffinity="0" density="0"/>
    <geom name="vis_awning_6" type="box" pos="5.0 -3.12 2.06" size="1.45 0.28 0.05"
      rgba="0.72 0.52 0.14 1" contype="0" conaffinity="0" density="0"/>

    <!-- Storefront windows and a small planted plaza. -->
    <geom name="window_1" type="box" pos="-4.5 3.99 1.9" size="0.75 0.015 0.7" material="city_glass"/>
    <geom name="window_2" type="box" pos="-1.0 4.59 1.8" size="0.7 0.015 0.8" material="city_glass"/>
    <geom name="window_3" type="box" pos="2.2 4.19 1.4" size="0.75 0.015 0.65" material="city_glass"/>
    <geom name="window_4" type="box" pos="5.5 3.89 1.8" size="0.75 0.015 0.75" material="city_glass"/>
    <geom name="planter_1" type="cylinder" pos="-5.0 3.15 0.18" size="0.45 0.18" material="city_grass"/>
    <geom name="tree_1" type="cylinder" pos="-5.0 3.15 0.9" size="0.10 0.75" material="tree_bark"/>
    <geom name="tree_top_1" type="sphere" pos="-5.0 3.15 1.85" size="0.58" material="tree_canopy"/>
    <geom name="planter_2" type="cylinder" pos="5.0 3.1 0.18" size="0.45 0.18" material="city_grass"/>
    <geom name="tree_2" type="cylinder" pos="5.0 3.1 0.9" size="0.10 0.75" material="tree_bark"/>
    <geom name="tree_top_2" type="sphere" pos="5.0 3.1 1.85" size="0.58" material="tree_canopy"/>

    <!-- Card R14: the block's one PORTAL. An entry wall runs west from bldg_1's
         west corner along the north sidewalk's inner edge, and `door_1` is the
         leaf set into it. Only `door_1` carries a semantic prefix; the two wall
         stubs are unclassified scene furniture exactly like `window_*`/`curb`,
         so the class extracts as ONE instance (city_semantics._instance_id
         gives every geom of an unlisted class its own instance id, so a
         multi-geom door would ground as several rival candidates).
         Sited at the block's west end on purpose: `default_dynamic_agent_specs`
         sends no pedestrian route west of x=-3.8 on the north sidewalk, so the
         approach band is clear of the crowd churn. The leaf sits at y=4.12,
         INSIDE the derived sidewalk polygon (y 2.2..4.2), so the threshold is
         standable ground and "do not stop in the doorway" is a claim about
         reachable geometry rather than about a wall. -->
    <geom name="entry_wall_1" type="box" pos="-7.625 4.12 1.17" size="0.275 0.08 1.05"
      material="entry_wall"/>
    <geom name="door_1" type="box" pos="-6.95 4.12 1.17" size="0.4 0.06 1.05"
      material="door_leaf"/>
    <geom name="entry_wall_2" type="box" pos="-6.425 4.12 1.17" size="0.125 0.08 1.05"
      material="entry_wall"/>

