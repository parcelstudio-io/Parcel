      <geom name="pedestrian_7_head" type="sphere" pos="0 0 1.75" size="0.19"
        contype="0" conaffinity="0" rgba="0.58 0.36 0.22 1" group="4"/>
      <geom name="vis_pedestrian_7" type="mesh" mesh="human_c" material="person_1"
        euler="0 0 3.05" contype="0" conaffinity="0" density="0"/>
    </body>
