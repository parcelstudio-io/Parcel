<mujoco model="parcel_city_block">
  <!-- Stylized city block for Go2 skill / RL development. -->
  <!-- Card W-1 (2026-08-21) textured this block. THE RULE THAT MAKES THAT SAFE:
       every pre-existing geom keeps its name, type, size, pos, quat, friction
       and contact flags, and every geom W-1 ADDS is named `vis_*` and carries
       contype="0" conaffinity="0" density="0". `vis_` matches no prefix in
       sim.LOGICAL_OBSTACLE_PREFIXES, headless_city._STATIC_OBSTACLE_PREFIXES,
       the semantics sidecar's geom/region prefix tables, or
       tests/test_city_orbit_clearance.STATIC_LOGICAL_PREFIXES, so nothing this
       card added can become an obstacle, a semantic instance, or a mass.
       tests/test_scene_assets.py pins both halves and compiles this file
       against its pre-W-1 revision to prove the dynamics arrays are identical.
       The only attributes changed on existing geoms are VISUAL ones:
       `material`, `rgba`, and `group` (the person capsules move to group 4,
       which MuJoCo's default mjvOption does not render, because the textured
       human meshes now stand in their place). -->
  <include file="../../../third_party/unitree_mujoco/unitree_robots/go2/go2.xml"/>
  <!-- go2.xml meshdir is relative to this scene file; override after include.
       texturedir is NOT set by go2.xml (it declares no textures), so this
       block's own textures resolve from `assets/textures/` beside this file.
       W-1's meshes cannot use meshdir - it is spoken for by the Go2 - so they
       climb back out of it explicitly; test_scene_assets.py asserts every
       referenced asset file exists. -->
  <compiler meshdir="../../../third_party/unitree_mujoco/unitree_robots/go2/assets"
    texturedir="assets/textures"
    angle="radian" autolimits="true"/>

  <statistic center="0 0 0.4" extent="8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.45 0.5 0.55 1"/>
    <global azimuth="-140" elevation="-18"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.45 0.62 0.82" rgb2="0.08 0.12 0.18"
      width="512" height="3072"/>
    <!-- W-1: photo-derived CC0 surface textures (Poly Haven), built by
         scratchpad/w1/build_assets.py. Provenance, licence and per-file
         sha256: assets/PROVENANCE.json. `type="cube"` on everything that
         dresses a box/cylinder/sphere: MuJoCo's 2d projection onto a box face
         streaks, cube mapping does not. Planes and UV meshes stay `2d`. -->
    <texture type="2d" name="asphalt" file="road_asphalt.png"/>
    <texture type="cube" name="sidewalk" file="sidewalk_concrete.png"/>
    <texture type="cube" name="curb_tex" file="curb_concrete.png"/>
    <texture type="cube" name="crosswalk_tex" file="crosswalk_paint.png"/>
    <texture type="cube" name="brick_tex" file="facade_brick.png"/>
    <texture type="cube" name="beige_tex" file="facade_beige.png"/>
    <texture type="cube" name="plaster_tex" file="facade_plaster.png"/>
    <texture type="cube" name="bench_tex" file="bench_wood.png"/>
    <texture type="cube" name="door_tex" file="door_wood.png"/>
    <texture type="cube" name="metal_tex" file="city_metal.png"/>
    <texture type="cube" name="bark_tex" file="tree_bark.png"/>
    <texture type="cube" name="canopy_tex" file="tree_canopy.png"/>
    <texture type="cube" name="grass_tex" file="grass.png"/>

    <material name="asphalt" texture="asphalt" texuniform="true" texrepeat="8 8" reflectance="0.05"/>
    <material name="sidewalk" texture="sidewalk" texuniform="true" texrepeat="1.6 1.6"
      reflectance="0.08"/>
    <material name="building_a" texture="brick_tex" texuniform="true" texrepeat="0.55 0.55"/>
    <material name="building_b" texture="beige_tex" texuniform="true" texrepeat="0.5 0.5"/>
    <material name="building_c" texture="plaster_tex" texuniform="true" texrepeat="0.5 0.5"/>
    <material name="crosswalk" texture="crosswalk_tex" texuniform="false" texrepeat="1 3"/>
    <material name="bench" texture="bench_tex" texuniform="false" texrepeat="3 1"/>
    <material name="curb" texture="curb_tex" texuniform="true" texrepeat="4 4"/>
    <material name="city_grass" texture="grass_tex" texuniform="true" texrepeat="1.4 1.4"/>
    <material name="city_glass" rgba="0.2 0.42 0.56 1" reflectance="0.35"/>
    <material name="city_metal" texture="metal_tex" texuniform="true" texrepeat="1 1"
      rgba="0.45 0.47 0.5 1"/>
    <material name="entry_wall" texture="plaster_tex" texuniform="true" texrepeat="0.9 0.9"/>
    <material name="door_leaf" texture="door_tex" texuniform="true" texrepeat="0.7 0.7"/>
    <material name="tree_bark" texture="bark_tex" texuniform="true" texrepeat="1.5 1.5"/>
    <material name="tree_canopy" texture="canopy_tex" texuniform="true" texrepeat="1.1 1.1"/>
    <material name="crate_wood" texture="bench_tex" texuniform="true" texrepeat="1.6 1.6"
      rgba="0.86 0.7 0.5 1"/>

    <!-- Storefront fascias. Each is one flat UV quad; the sign lettering,
         glazing, mullions and entrance are baked into the image, so a
         storefront is one geom rather than a dozen. -->
    <texture type="2d" name="shopfront_a" file="storefront_a.png"/>
    <texture type="2d" name="shopfront_b" file="storefront_b.png"/>
    <texture type="2d" name="shopfront_c" file="storefront_c.png"/>
    <texture type="2d" name="shopfront_d" file="storefront_d.png"/>
    <material name="shopfront_a" texture="shopfront_a"/>
    <material name="shopfront_b" texture="shopfront_b"/>
    <material name="shopfront_c" texture="shopfront_c"/>
    <material name="shopfront_d" texture="shopfront_d"/>

    <!-- Pedestrian skins. Four silhouettes x six outfits; nine bodies in this
         scene use nine distinct (mesh, texture) pairs so a detector cannot
         memorise one appearance. -->
    <texture type="2d" name="person_1" file="person_1.png"/>
    <texture type="2d" name="person_2" file="person_2.png"/>
    <texture type="2d" name="person_3" file="person_3.png"/>
    <texture type="2d" name="person_4" file="person_4.png"/>
    <texture type="2d" name="person_5" file="person_5.png"/>
    <texture type="2d" name="person_6" file="person_6.png"/>
    <material name="person_1" texture="person_1"/>
    <material name="person_2" texture="person_2"/>
    <material name="person_3" texture="person_3"/>
    <material name="person_4" texture="person_4"/>
    <material name="person_5" texture="person_5"/>
    <material name="person_6" texture="person_6"/>


    <mesh name="human_a" inertia="shell"
      file="../../../../../src/parcel_robot/scenes/assets/meshes/human_a.obj"/>
    <mesh name="human_b" inertia="shell"
      file="../../../../../src/parcel_robot/scenes/assets/meshes/human_b.obj"/>
    <mesh name="human_c" inertia="shell"
      file="../../../../../src/parcel_robot/scenes/assets/meshes/human_c.obj"/>
    <mesh name="human_d" inertia="shell"
      file="../../../../../src/parcel_robot/scenes/assets/meshes/human_d.obj"/>
    <mesh name="shopfront_1" inertia="shell" scale="3.0 1 2.5"
      file="../../../../../src/parcel_robot/scenes/assets/meshes/panel.obj"/>
    <mesh name="shopfront_2" inertia="shell" scale="2.4 1 2.7"
      file="../../../../../src/parcel_robot/scenes/assets/meshes/panel.obj"/>
    <mesh name="shopfront_3" inertia="shell" scale="2.6 1 2.4"
      file="../../../../../src/parcel_robot/scenes/assets/meshes/panel.obj"/>
    <mesh name="shopfront_4" inertia="shell" scale="2.8 1 2.6"
      file="../../../../../src/parcel_robot/scenes/assets/meshes/panel.obj"/>
    <mesh name="shopfront_5" inertia="shell" scale="2.9 1 2.5"
      file="../../../../../src/parcel_robot/scenes/assets/meshes/panel.obj"/>
    <mesh name="shopfront_6" inertia="shell" scale="3.0 1 2.6"
      file="../../../../../src/parcel_robot/scenes/assets/meshes/panel.obj"/>
  </asset>

  <worldbody>
    <light pos="2 1 6" dir="-0.2 -0.1 -1" diffuse="0.8 0.8 0.75" castshadow="true"/>
    <light pos="-3 -2 5" dir="0.3 0.2 -1" diffuse="0.35 0.35 0.4"/>

    <!-- Road -->
    <geom name="road" type="plane" size="12 12 0.05" material="asphalt" friction="0.9"/>

    <!-- Sidewalk strip -->
    <geom name="sidewalk" type="box" pos="0 3.2 0.06" size="8 1.0 0.06" material="sidewalk"/>
    <geom name="curb" type="box" pos="0 2.15 0.05" size="8 0.08 0.05" material="curb"/>
    <geom name="sidewalk_south" type="box" pos="0 -3.0 0.06" size="8 0.75 0.06" material="sidewalk"/>
    <geom name="curb_south" type="box" pos="0 -2.2 0.05" size="8 0.08 0.05" material="curb"/>

    <!-- Lane markings make heading and motion easier to judge. -->
    <geom name="lane_1" type="box" pos="-5.5 0 0.003" size="1.1 0.035 0.003" rgba="0.92 0.78 0.18 1"/>
    <geom name="lane_2" type="box" pos="-2.7 0 0.003" size="1.1 0.035 0.003" rgba="0.92 0.78 0.18 1"/>
    <geom name="lane_3" type="box" pos="0.1 0 0.003" size="1.1 0.035 0.003" rgba="0.92 0.78 0.18 1"/>
    <geom name="lane_4" type="box" pos="5.7 0 0.003" size="1.1 0.035 0.003" rgba="0.92 0.78 0.18 1"/>

    <!-- Crosswalk stripes -->
    <geom name="xw1" type="box" pos="2.5 0.8 0.002" size="0.15 1.2 0.002" material="crosswalk"/>
    <geom name="xw2" type="box" pos="2.9 0.8 0.002" size="0.15 1.2 0.002" material="crosswalk"/>
    <geom name="xw3" type="box" pos="3.3 0.8 0.002" size="0.15 1.2 0.002" material="crosswalk"/>
    <geom name="xw4" type="box" pos="3.7 0.8 0.002" size="0.15 1.2 0.002" material="crosswalk"/>

    <!-- Buildings -->
    <geom name="bldg_1" type="box" pos="-4.5 5.5 2.0" size="1.8 1.5 2.0" material="building_a"/>
    <geom name="bldg_2" type="box" pos="-1.0 5.8 2.8" size="1.4 1.2 2.8" material="building_b"/>
    <geom name="bldg_3" type="box" pos="2.2 5.6 1.6" size="1.5 1.4 1.6" material="building_c"/>
    <geom name="bldg_4" type="box" pos="5.5 5.4 2.4" size="1.6 1.5 2.4" material="building_a"/>
    <geom name="bldg_5" type="box" pos="-5.5 -4.5 1.8" size="1.7 1.4 1.8" material="building_b"/>
    <geom name="bldg_6" type="box" pos="5.0 -5.0 2.2" size="1.8 1.6 2.2" material="building_c"/>

    <!-- W-1: the storefronts. One textured quad per building face, standing
         30-40 mm proud of the facade, carrying its own glazing, entrance and
         fascia sign. These are the `storefront` and `door` visual evidence the
         2026-08-21 detector bench found the block had none of. Purely visual:
         the building box behind each one is still the whole collision story. -->
    <geom name="vis_shopfront_1" type="mesh" mesh="shopfront_1" material="shopfront_a"
      pos="-4.5 3.965 0.06" contype="0" conaffinity="0" density="0"/>
    <geom name="vis_shopfront_2" type="mesh" mesh="shopfront_2" material="shopfront_b"
      pos="-1.0 4.565 0.06" contype="0" conaffinity="0" density="0"/>
