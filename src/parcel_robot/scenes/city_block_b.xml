         variant that only moves boxes is a weak held-out set. -->
    <headlight diffuse="0.52 0.52 0.55" ambient="0.30 0.31 0.34" specular="0 0 0"/>
    <rgba haze="0.52 0.54 0.58 1"/>
    <global azimuth="35" elevation="-24"/>
  </visual>

