      reflectance="0.04"/>
    <material name="sidewalk" texture="sidewalk_b" texuniform="true" texrepeat="1.3 1.3"
      reflectance="0.07"/>
    <material name="building_a" texture="plaster_b" texuniform="true" texrepeat="0.45 0.45"/>
    <material name="building_b" texture="brick_b" texuniform="true" texrepeat="0.6 0.6"/>
    <material name="building_c" texture="beige_b" texuniform="true" texrepeat="0.4 0.4"/>
    <material name="crosswalk" texture="crosswalk_b" texuniform="false" texrepeat="3 1"/>
