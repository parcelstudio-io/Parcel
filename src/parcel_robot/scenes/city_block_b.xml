    <texture type="cube" name="sidewalk_b" file="sidewalk_concrete_b.png"/>
    <texture type="cube" name="curb_b" file="curb_concrete.png"/>
    <texture type="cube" name="crosswalk_b" file="crosswalk_paint.png"/>
    <texture type="cube" name="brick_b" file="facade_brick_b.png"/>
    <texture type="cube" name="beige_b" file="facade_beige_b.png"/>
    <texture type="cube" name="plaster_b" file="facade_plaster_b.png"/>
    <texture type="cube" name="bench_b" file="bench_wood_b.png"/>
    <texture type="cube" name="door_b" file="door_wood_b.png"/>
