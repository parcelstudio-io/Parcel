{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parcel.local/schemas/execution_result_v1.schema.json",
  "title": "Parcel ExecutionResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "plan_revision",
    "step_id",
    "attempt",
    "status",
    "feedback_code",
    "snapshot_id",
    "verified_facts",
    "checkpoint",
    "detail_code",
    "started_at_monotonic_s",
    "finished_at_monotonic_s"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"$ref": "#/$defs/identifier"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "step_id": {"$ref": "#/$defs/identifier"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "status": {"enum": ["in_progress", "succeeded", "blocked", "failed", "cancelled", "timed_out"]},
    "feedback_code": {
      "enum": ["in_progress", "succeeded", "blocked", "target_lost", "perception_stale", "owner_moved", "scene_changed", "battery_changed", "cancelled", "timed_out", "failed"]
    },
    "snapshot_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
    "verified_facts": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/fact"}
    },
    "checkpoint": {"type": "boolean"},
    "detail_code": {"type": "string", "minLength": 1, "maxLength": 120},
    "started_at_monotonic_s": {"type": "number", "minimum": 0},
    "finished_at_monotonic_s": {
      "oneOf": [{"type": "null"}, {"type": "number", "minimum": 0}]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "target", "source", "confidence"],
      "properties": {
        "fact": {"type": "string", "minLength": 1, "maxLength": 80},
        "target": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 160}
          ]
        },
        "source": {"type": "string", "minLength": 1, "maxLength": 80},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
